{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git-danger.py\"; [ ! -f \"$f\" ] || python3 \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-nested-claude-md.sh\"; [ ! -f \"$f\" ] || bash \"$f\""
          },
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-edit.py\"; [ ! -f \"$f\" ] || python3 \"$f\""
          },
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-md-budget-on-edit.py\"; [ ! -f \"$f\" ] || python3 \"$f\""
          },
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-budget-on-edit.py\"; [ ! -f \"$f\" ] || python3 \"$f\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/require-pr-on-stop.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
