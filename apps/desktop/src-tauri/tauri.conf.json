{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VFS",
  "version": "0.2.2",
  "identifier": "app.vfs.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VFS — Buscador de archivos",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "category": "Utility",
    "publisher": "VFS",
    "shortDescription": "Buscador de archivos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0RjMzQzYwODlGQ0JEMUEKUldRYXZmeUpZRHp6MU9DVVpxYm05ZWV3S3p5N1A3VzZmL0xqT04xNWhScmwxQXU0T2dteHFxQzgK",
      "endpoints": ["https://github.com/AndresHG/VFS/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
